<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <title>Initiative Tracker</title>

        <script src="https://cdn.jsdelivr.net/npm/handlebars@latest/dist/handlebars.runtime.js"></script>
        <style>
            body {
                background: url({{ backgroundImg }});
                {{# if stretchImg }} 
                    background-size: 100%;
                    background-attachment: fixed;
                {{/ if}}
            }
            .bkgd-col {
                background-color: {{# if blockCol }} {{ blockCol }} {{ else }} tan {{/ if }};
            }
            .dark-col {
                background-color: {{# if darkCol }} {{ darkCol }} {{ else }} rgb(204, 164, 112) {{/ if }};
            }
            @media (max-width: 1200px) {
                body {
                    {{# if stretchImg }} 
                        background-size: auto 100%;
                    {{/ if}}
                }
            }

            #arch {
                position: absolute;
                width: 110%;
                left: -6%;
                height: 150px;
            }
            #column-left {
                position: absolute;
                left: 0px;
                top: 120px;
                width: 18%;
            }
            #column-right {
                position: absolute;
                right: 0px;
                top: 120px;
                width: 18%;
            }
        </style>
    </head>

    <body>
        <div id="login">
            <label for="secret-key">Enter Password</label>
            <input type="text" id="secret-key">
            <input type="submit" id="submit-pw" value="Submit">
        </div>
        <div id="content" hidden>
            <!--<img id='arch' src='./images/archway_top.png'>
            <img id='column-left' src='./images/pillarL.png'>
            <img id='column-right' src='./images/pillarR.png'>-->
        
            {{{ body }}}
        </div>
    </body>
</html>